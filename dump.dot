digraph G {
 rankdir=LR;
 splines=true;
 nodesep=0.6;
 ranksep=1.5;
 node [shape=none, margin=0, fontname="Helvetica"];
 edge [fontname="Helvetica", fontsize=12];
 anchor [shape=point, style=invis, width=0];
 { rank=same; anchor;  }
 node0 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="gold">
 <tr><td colspan="2"><b>INDEX = 0</b></td></tr>
 <tr><td colspan="2">SENTINEL</td></tr>
 <tr><td>NEXT = 1</td><td>PREV = 2</td></tr>
 </table>
 >];
 node1 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="orange">
 <tr><td colspan="2"><b>INDEX = 1</b></td></tr>
 <tr><td colspan="2">DATA = 7</td></tr>
 <tr><td>NEXT = 5</td><td>PREV = 0</td></tr>
 </table>
 >];
 node2 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="violet">
 <tr><td colspan="2"><b>INDEX = 2</b></td></tr>
 <tr><td colspan="2">DATA = 6</td></tr>
 <tr><td>NEXT = 0</td><td>PREV = 4</td></tr>
 </table>
 >];
 node3 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="green">
 <tr><td colspan="2"><b>INDEX = 3</b></td></tr>
 <tr><td colspan="2">FREE</td></tr>
 <tr><td colspan="2">NEXT = 6</td></tr>
 </table>
 >];
 node4 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#add8e6">
 <tr><td colspan="2"><b>INDEX = 4</b></td></tr>
 <tr><td colspan="2">DATA = 13</td></tr>
 <tr><td>NEXT = 2</td><td>PREV = 5</td></tr>
 </table>
 >];
 node5 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#add8e6">
 <tr><td colspan="2"><b>INDEX = 5</b></td></tr>
 <tr><td colspan="2">DATA = 17</td></tr>
 <tr><td>NEXT = 4</td><td>PREV = 1</td></tr>
 </table>
 >];
 node6 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="green">
 <tr><td colspan="2"><b>INDEX = 6</b></td></tr>
 <tr><td colspan="2">FREE</td></tr>
 <tr><td colspan="2">NEXT = 7</td></tr>
 </table>
 >];
 node7 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="green">
 <tr><td colspan="2"><b>INDEX = 7</b></td></tr>
 <tr><td colspan="2">FREE</td></tr>
 <tr><td colspan="2">NEXT = 8</td></tr>
 </table>
 >];
 node8 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="green">
 <tr><td colspan="2"><b>INDEX = 8</b></td></tr>
 <tr><td colspan="2">FREE</td></tr>
 <tr><td colspan="2">NEXT = 9</td></tr>
 </table>
 >];
 node9 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="green">
 <tr><td colspan="2"><b>INDEX = 9</b></td></tr>
 <tr><td colspan="2">FREE</td></tr>
 <tr><td colspan="2">NEXT = 10</td></tr>
 </table>
 >];
 node10 [label=<
 <table border="1" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="green">
 <tr><td colspan="2"><b>INDEX = 10</b></td></tr>
 <tr><td colspan="2">FREE</td></tr>
 <tr><td colspan="2">NEXT = -1</td></tr>
 </table>
 >];
 anchor -> node0 [style=invis];
 anchor -> node1 [style=invis];
 node0 -> node1 [style=invis, weight=100];
 anchor -> node2 [style=invis];
 node1 -> node2 [style=invis, weight=100];
 anchor -> node3 [style=invis];
 node2 -> node3 [style=invis, weight=100];
 anchor -> node4 [style=invis];
 node3 -> node4 [style=invis, weight=100];
 anchor -> node5 [style=invis];
 node4 -> node5 [style=invis, weight=100];
 anchor -> node6 [style=invis];
 node5 -> node6 [style=invis, weight=100];
 anchor -> node7 [style=invis];
 node6 -> node7 [style=invis, weight=100];
 anchor -> node8 [style=invis];
 node7 -> node8 [style=invis, weight=100];
 anchor -> node9 [style=invis];
 node8 -> node9 [style=invis, weight=100];
 anchor -> node10 [style=invis];
 node9 -> node10 [style=invis, weight=100];
 node0:n -> node1:n [color=blue, constraint=false, penwidth=1.5, label="HEAD", fontcolor=blue, fontsize=17];
 node0:s -> node2:s [color=red, constraint=false, penwidth=1.5, label="TAIL", fontcolor=red, fontsize=17];
 node1:n -> node5:n [color=blue, constraint=false, penwidth=1.5];
 node2:s -> node4:s [color=red, constraint=false, penwidth=1.5];
 node3 -> node6 [color=green, style=dashed, constraint=false];
 node4:n -> node2:n [color=blue, constraint=false, penwidth=1.5];
 node4:s -> node5:s [color=red, constraint=false, penwidth=1.5];
 node5:n -> node4:n [color=blue, constraint=false, penwidth=1.5];
 node5:s -> node1:s [color=red, constraint=false, penwidth=1.5];
 node6 -> node7 [color=green, style=dashed, constraint=false];
 node7 -> node8 [color=green, style=dashed, constraint=false];
 node8 -> node9 [color=green, style=dashed, constraint=false];
 node9 -> node10 [color=green, style=dashed, constraint=false];
}
